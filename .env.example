# Настройки Pocket Beacon. Файл необязателен: при первом запуске сервер
# сам создаст .env со случайным SESSION_SECRET. Администратор по умолчанию —
# admin/admin; сервер при запуске предложит сменить стандартный пароль.

# Порт HTTPS-сервера. Если занят — сервер предложит свободный и запомнит его.
PORT=3443

# IP-адрес сервера в локальной сети.
# Оставьте пустым — определится автоматически.
# Заполните вручную, если автоопределение выбрало не тот адаптер (VPN, WSL и т.п.)
HOST_IP=

# Секрет для подписи сессий. Пусто — сгенерируется автоматически при первом запуске.
SESSION_SECRET=

# Логин администратора (необязательно, по умолчанию admin)
# ADMIN_LOGIN=admin

# Начальный пароль администратора (необязательно, по умолчанию admin).
# Пока пароль стандартный, сервер при запуске предлагает его сменить.
# ADMIN_PASSWORD=
