# Скопируйте этот файл в .env и заполните значения

# Порт HTTPS-сервера
PORT=3443

# IP-адрес сервера в локальной сети.
# Оставьте пустым — определится автоматически.
# Заполните вручную, если автоопределение выбрало не тот адаптер (VPN, WSL и т.п.)
HOST_IP=

# Секрет для подписи сессий. Придумайте длинную случайную строку.
SESSION_SECRET=change-me-to-a-long-random-string

# Логин и пароль администратора (создаётся при первом запуске)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me
